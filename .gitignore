# ==============================================================================
# PulseChat Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.*
*.env
**/.env
**/.env.*
!**/.env.example
!**/.env.template
!**/.env.sample

# Private credentials, certs, and keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Build & Output Artifacts
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/

# TypeScript Cache & Definitions
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel/
**/.vercel/

# Logs & Debugging
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Code Coverage
coverage/
**/coverage/
*.lcov
.nyc_output/
.playwright/
test-results/

# AI Service & Python (FastAPI / Flask / PyTorch / LangChain)
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
**/env/
venv/
**/venv/
.venv/
**/.venv/
ENV/
**/ENV/
env.bak/
venv.bak/
develop-eggs/
.eggs/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Local Database Files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# IDEs and Editors
.idea/
**/.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
