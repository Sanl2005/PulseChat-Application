# ==========================================
# PulseChat Backend Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Google Gemini API Key & Model
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pulsechat
DB_USER=postgres
DB_PASSWORD=your_database_password_here

DATABASE_URL=postgresql://postgres:your_database_password_here@localhost:5432/pulsechat

# Authentication
JWT_SECRET=your_jwt_secret_key_here
